# Secrets: keys live only in local .env files (templates: .env.example)
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend tooling (frontend/dist is committed: the app runs without Node)
node_modules/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/stats.html
frontend/.vite/
*.tsbuildinfo
# Vite copies public/emoji into dist on every build; the backend serves public/emoji
# when dist has no copy, so the 4.7 MB of Noto emoji are committed once.
frontend/dist/emoji/

# Test coverage
.coverage
htmlcov/
coverage/

# Third-party review texts (2GIS): kept locally, not published
collector/output/
collector/data/raw/
collector/data/processed/

# Local artifacts
*.log
*.tmp
*.zip
# Hand-over notes that ship inside the zip next to the code
/README.txt
/changes.patch
SHA256SUMS.txt
.claude/
.DS_Store
Thumbs.db
.idea/
.vscode/
