# Copy to .env. Never put keys in frontend variables.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Gemini 3 thinks at "high" by default (tens of seconds); low is enough here.
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=60

# Voice answers (optional). Without a key the browser voice is used.
ELEVENLABS_API_KEY=
# Separate voices for Russian and Kazakh (any voice IDs from your ElevenLabs library).
ELEVENLABS_VOICE_ID_RU=
ELEVENLABS_VOICE_ID_KK=
# Used for a language whose own voice is not set; empty = premade multilingual voice.
ELEVENLABS_VOICE_ID=
# Eleven v3 for both languages (only v3 supports Kazakh). eleven_flash_v2_5 is faster for Russian.
ELEVENLABS_MODEL_RU=eleven_v3
ELEVENLABS_MODEL_KK=eleven_v3
