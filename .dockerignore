# Secrets never enter images; compose passes .env at runtime.
.env
.env.*
!.env.example
.git
.venv
**/__pycache__
**/.pytest_cache
*.log
.claude

# Rebuilt inside the image / not needed in the build context
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report

# Large local-only data (mounted as volumes by the data services)
collector/output
collector/data
